# ─────────────────────────────────────────────────────────────
# Runtime & local toolchain — large, rebuildable, machine-specific
# ─────────────────────────────────────────────────────────────
node_modules/

# Playwright browser bundle + bundled ffmpeg binary used only to make review recordings
review/**/tools/
review/**/*.exe

# ─────────────────────────────────────────────────────────────
# Review media evidence (recordings + screenshots).
# Kept locally only — every item below is regenerable by re-running the scripts.
# ─────────────────────────────────────────────────────────────
*.webm
*.mp4
*.png
*.jpg
*.jpeg
**/recordings/raw/
**/recordings/inspect/
**/*-frames/

# ─────────────────────────────────────────────────────────────
# Frame extractions of the reference clip — regenerable from the source video
# ─────────────────────────────────────────────────────────────
review/reference-motion-analysis/frames/

# ─────────────────────────────────────────────────────────────
# One-off probes and debug scripts (diagnosis artifacts, not project assets)
# ─────────────────────────────────────────────────────────────
review/**/probe/
review/**/debug-*.mjs
review/**/probe-*.mjs

# ─────────────────────────────────────────────────────────────
# Build output — regenerated by build.mjs by copying dist/
# ─────────────────────────────────────────────────────────────
review/**/build/

# ─────────────────────────────────────────────────────────────
# OS cruft
# ─────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini
