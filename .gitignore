# ─────────────────────────────────────────────────────────────
# Runtime & local toolchain — large, rebuildable, machine-specific
# ─────────────────────────────────────────────────────────────
node_modules/

# Playwright browser bundle + bundled ffmpeg binary used only to make review recordings
review/**/tools/
review/**/*.exe

# ─────────────────────────────────────────────────────────────
# Review media evidence (recordings + screenshots).
# Kept locally only — every item below is regenerable by re-running the scripts.
# ─────────────────────────────────────────────────────────────
*.webm
*.mp4
*.png
*.jpg
*.jpeg
**/recordings/raw/
**/recordings/inspect/
**/*-frames/

# ─────────────────────────────────────────────────────────────
# Frame extractions of the reference clip — regenerable from the source video
# ─────────────────────────────────────────────────────────────
review/reference-motion-analysis/frames/

# ─────────────────────────────────────────────────────────────
# One-off probes and debug scripts (diagnosis artifacts, not project assets)
# ─────────────────────────────────────────────────────────────
review/**/probe/
review/**/debug-*.mjs
review/**/probe-*.mjs

# ─────────────────────────────────────────────────────────────
# Build output — regenerated by build.mjs by copying dist/
# ─────────────────────────────────────────────────────────────
review/**/build/

# ─────────────────────────────────────────────────────────────
# OS cruft
# ─────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# Motion Refinement Slice 1 local evidence; keep only selected scripts and acceptance notes.
review/homepage-motion-refinement-1/checkpoint/
review/homepage-motion-refinement-1/checkpoint-sha256.json
review/homepage-motion-refinement-1/cap-mask.mjs
review/homepage-motion-refinement-1/*.log
review/homepage-motion-refinement-1/results.json
review/homepage-motion-refinement-1/recordings/
review/homepage-motion-refinement-1/cancel-fix/*
!review/homepage-motion-refinement-1/cancel-fix/targeted.mjs
!review/homepage-motion-refinement-1/cancel-fix/修复说明.md

# Slice 2 local machine-generated evidence.
review/homepage-motion-refinement-2/results.json
